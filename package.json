{
  "name": "fileburger",
  "version": "2.0.0",
  "description": "Free peer-to-peer file transfers in your browser, with extra sauce.",
  "license": "BSD-3-Clause",
  "keywords": [
    "webrtc",
    "peer-to-peer",
    "file-sharing",
    "file-transfer"
  ],
  "scripts": {
    "dev": "next",
    "build": "next build && node scripts/copy-standalone.mjs",
    "start": "next start",
    "start:peerjs": "node bin/peerjs-server.js",
    "lint:check": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "type:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:clean": "docker compose down -v --rmi all",
    "verify": "pnpm lint:check && pnpm format:check && pnpm type:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@tanstack/react-query": "^5.55.2",
    "autoprefixer": "^10.4.20",
    "debug": "^4.3.6",
    "express": "^5.0.0",
    "ioredis": "^5.4.2",
    "next": "~15.5.11",
    "next-themes": "^0.4.4",
    "next-view-transitions": "^0.3.4",
    "peer": "^1.0.0",
    "peerjs": "^1.5.4",
    "postcss": "^8.4.44",
    "react": "~19.2.3",
    "react-device-detect": "^2.0.0",
    "react-dom": "~19.2.3",
    "react-qr-code": "^2.0.15",
    "streamsaver": "^2.0.6",
    "web-streams-polyfill": "^4.0.0",
    "webrtcsupport": "^2.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/debug": "^4.1.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.18.2",
    "vitest": "^3.2.4"
  }
}
